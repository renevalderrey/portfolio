---
import SectionHeader from './SectionHeader.astro';
import { education, experience } from '../data/experience';
import { stack } from '../data/home';
import { useT } from '../i18n/ui';
import { getLang } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
---

<section id="trayectoria" class="container-page py-16 sm:py-20" aria-labelledby="trayectoria-title">
  <SectionHeader id="trayectoria-title" eyebrow={t.experience.eyebrow} title={t.experience.title} lead={t.experience.lead} />

  <ol class="relative ml-2 border-l border-border-strong sm:ml-4">
    {
      experience.map((r) => (
        <li class="reveal relative pb-8 pl-7 last:pb-0 sm:pl-10">
          <span
            class:list={[
              'absolute -left-[7px] top-7 size-3.5 rounded-full border-[3px] border-bg',
              r.current ? 'bg-accent' : 'bg-border-strong',
            ]}
            aria-hidden="true"
          />
          <div class="glass p-6 sm:p-7">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <h3 class="text-lg sm:text-xl">
                {r.title[lang]} <span class="font-normal text-subtle">· {r.company}</span>
              </h3>
              <p class:list={['text-sm font-medium', r.current ? 'text-accent-text' : 'text-subtle']}>{r.period[lang]}</p>
            </div>
            {r.context && <p class="mt-1 text-sm text-subtle">{r.context[lang]}</p>}
            <ul class="mt-4 space-y-2 text-muted">
              {r.highlights[lang].map((h) => (
                <li class="flex gap-3">
                  <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-border-strong" aria-hidden="true" />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
            {r.stack && (
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {r.stack.map((s) => (
                  <li class="chip text-xs">{s}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <div class="mt-14 grid gap-4 lg:grid-cols-[1fr_2fr]">
    <div class="reveal">
      <h3 class="eyebrow mb-4">{t.experience.education}</h3>
      <ul class="space-y-3">
        {
          education.map((e) => (
            <li class="glass p-5">
              <p class="font-semibold">{e.title[lang]}</p>
              <p class="mt-1 text-sm text-muted">
                {e.place} · {e.period[lang]}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="reveal">
      <h3 class="eyebrow mb-4">{t.stack.eyebrow}</h3>
      <div class="glass grid gap-5 p-6 sm:grid-cols-2">
        {
          stack.map((g) => (
            <div>
              <p class="text-sm font-semibold">{g.group[lang]}</p>
              <ul class="mt-2.5 flex flex-wrap gap-1.5">
                {g.items.map((it) => (
                  <li class="chip text-xs">{it}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
