---
import Icon from './Icon.astro';
import { useT } from '../i18n/ui';
import { getLang, homeAnchor, profile } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const cv = profile.cv[lang];

const lines =
  lang === 'es'
    ? [
        ['spec', 'criterios de aceptación'],
        ['plan', 'modelo de datos + contratos'],
        ['build', 'agentes de IA en paralelo'],
        ['verify', 'contra la spec, no el código'],
        ['launch', 'SEO + Google Ads + Meta Ads'],
      ]
    : [
        ['spec', 'acceptance criteria'],
        ['plan', 'data model + contracts'],
        ['build', 'AI agents in parallel'],
        ['verify', 'against the spec, not the code'],
        ['launch', 'SEO + Google Ads + Meta Ads'],
      ];
---

<section class="container-page grid items-center gap-12 pb-20 pt-14 sm:pt-20 lg:grid-cols-[1.25fr_1fr] lg:gap-10 lg:pb-28 lg:pt-28">
  <div>
    <p class="rise chip mb-6 text-success" style="--i:0">
      <span class="relative flex size-2">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-success opacity-60 motion-reduce:animate-none"></span>
        <span class="relative inline-flex size-2 rounded-full bg-success"></span>
      </span>
      {t.hero.status}
    </p>
    <p class="rise eyebrow mb-4" style="--i:1">{t.hero.role}</p>
    <h1 class="rise-soft text-[clamp(2.5rem,7.5vw,4.75rem)] font-bold">
      {t.hero.titleA}
      <span class="text-gradient block">{t.hero.titleB}</span>
    </h1>
    <p class="rise-soft mt-6 max-w-xl text-lg text-muted">{t.hero.lead}</p>

    <div class="rise mt-9 flex flex-wrap gap-3" style="--i:4">
      <a href={homeAnchor(lang, 'proyectos')} class="btn btn-primary">
        {t.hero.ctaProjects}
        <Icon name="arrow" size={18} />
      </a>
      <a href={homeAnchor(lang, 'contacto')} class="btn btn-outline">{t.hero.ctaContact}</a>
      {
        cv && (
          <a href={cv} class="btn btn-outline" download>
            <Icon name="download" size={18} />
            {t.hero.ctaCv}
          </a>
        )
      }
    </div>

    <div class="rise mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-subtle" style="--i:5">
      <span class="inline-flex items-center gap-1.5"><Icon name="pin" size={16} />{t.hero.location}</span>
      <a href={profile.linkedin} target="_blank" rel="me noopener" class="inline-flex min-h-11 items-center gap-1.5 hover:text-text">
        <Icon name="linkedin" size={16} />LinkedIn
      </a>
      <a href={profile.github} target="_blank" rel="me noopener" class="inline-flex min-h-11 items-center gap-1.5 hover:text-text">
        <Icon name="github" size={16} />GitHub
      </a>
    </div>
  </div>

  <div class="rise relative" style="--i:3" aria-hidden="true">
    <div class="absolute -inset-3 -z-10 rounded-[2rem] sm:-inset-6 bg-linear-to-br from-accent/25 via-accent-2/10 to-transparent blur-2xl"></div>
    <div class="card p-0 font-mono text-[0.8125rem] sm:text-sm">
      <div class="flex items-center gap-2 border-b border-border px-4 py-3">
        <span class="size-3 rounded-full bg-danger/80"></span>
        <span class="size-3 rounded-full bg-accent-3/70"></span>
        <span class="size-3 rounded-full bg-success/80"></span>
        <span class="ml-2 text-xs text-subtle">~/proyectos/tu-negocio</span>
      </div>
      <div class="space-y-2.5 p-5">
        <p class="text-muted"><span class="text-accent-2">$</span> /sdd "{lang === 'es' ? 'tu próxima idea' : 'your next idea'}"</p>
        {
          lines.map(([k, v], i) => (
            <p class="type-line flex gap-3" style={`--d:${i}`}>
              <span class="text-success">✓</span>
              <span class="w-14 shrink-0 text-accent">{k}</span>
              <span class="text-muted">{v}</span>
            </p>
          ))
        }
        <p class="type-line pt-1 text-text" style={`--d:${lines.length}`}>
          <span class="text-accent-2">→</span> {lang === 'es' ? 'en producción, con clientes' : 'live, with customers'}
          <span class="caret ml-1 inline-block h-4 w-2 translate-y-0.5 bg-accent-2"></span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .type-line {
      animation: line-in 0.45s ease-out backwards;
      animation-delay: calc(0.7s + var(--d) * 0.28s);
    }
    .caret {
      animation: blink 1.1s steps(1) infinite;
    }
  }
  @keyframes line-in {
    from {
      opacity: 0;
      translate: -0.5rem 0;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
