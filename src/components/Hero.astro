---
import { Image } from 'astro:assets';
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import { featured } from '../data/projects';
import { useT } from '../i18n/ui';
import { getLang, homeAnchor, profile } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const cv = profile.cv[lang];
const shot = featured.cover!;

// Posición de cada etiqueta flotante alrededor de la captura (solo desde sm).
const spots = ['-left-4 -top-4', '-right-3 top-10', '-left-6 bottom-16', '-right-4 -bottom-3', 'left-1/4 -bottom-6'];
---

<section class="container-page grid items-center gap-14 pb-20 pt-12 sm:pt-20 lg:grid-cols-[1.3fr_1fr] lg:gap-12 lg:pb-28 lg:pt-24">
  <div>
    <div class="rise mb-8 flex items-center gap-3.5" style="--i:0">
      <div class="relative">
        <Avatar size={56} eager class="ring-4 ring-surface" />
        <span class="absolute bottom-0.5 right-0.5 flex size-3.5 rounded-full border-2 border-surface bg-success" aria-hidden="true"></span>
      </div>
      <div>
        <p class="font-semibold">{t.hero.hello}</p>
        <p class="flex items-center gap-1.5 text-sm text-muted">{t.hero.status}</p>
      </div>
    </div>
    <h1 class="rise-soft text-[clamp(2.5rem,6.4vw,4.25rem)]">
      {t.hero.titleA}
      <span class="text-muted">{t.hero.titleB}</span>
      <span class="mark">{t.hero.titleC}</span>
    </h1>
    <p class="rise-soft mt-6 max-w-xl text-lg text-muted">{t.hero.lead}</p>

    <div class="rise mt-9 flex flex-wrap gap-3" style="--i:3">
      <a href={homeAnchor(lang, 'contacto')} class="btn btn-primary">
        {t.hero.ctaContact}
        <Icon name="arrow" size={18} />
      </a>
      <a href={homeAnchor(lang, 'trabajos')} class="btn btn-glass">{t.hero.ctaProjects}</a>
      {
        cv && (
          <a href={cv} class="btn btn-glass" download>
            <Icon name="download" size={18} />
            {t.hero.ctaCv}
          </a>
        )
      }
    </div>

    <div class="rise-soft mt-8 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-muted">
      <span class="inline-flex items-center gap-1.5"><Icon name="pin" size={16} />{t.hero.location}</span>
      <a href={profile.linkedin} target="_blank" rel="me noopener" class="inline-flex min-h-11 items-center gap-1.5 hover:text-text">
        <Icon name="linkedin" size={16} />LinkedIn
      </a>
      <a href={profile.github} target="_blank" rel="me noopener" class="inline-flex min-h-11 items-center gap-1.5 hover:text-text">
        <Icon name="github" size={16} />GitHub
      </a>
    </div>
  </div>

  <div class="rise relative sm:px-6" style="--i:2">
    <div class="glass rounded-[2rem] p-2.5 sm:p-3">
      <div class="overflow-hidden rounded-[1.4rem] border border-border">
        <Image
          src={shot.src}
          alt={t.hero.shotAlt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 520px, 100vw"
          loading="eager"
          class="block h-auto w-full"
        />
      </div>
    </div>

    <ul class="mt-4 flex flex-wrap gap-2 sm:mt-0" aria-label={lang === 'es' ? 'Servicios' : 'Services'}>
      {
        t.hero.floating.map((label, i) => (
          <li class:list={['sm:absolute', spots[i]]}>
            <span class="bob glass inline-flex items-center gap-2 rounded-full px-3.5 py-2 text-sm font-semibold" style={`--i:${i}`}>
              <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
              {label}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
