---
import SectionHeader from './SectionHeader.astro';
import { process } from '../data/home';
import { useT } from '../i18n/ui';
import { getLang } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
---

<section id="proceso" class="container-page py-16 sm:py-20" aria-labelledby="proceso-title">
  <SectionHeader id="proceso-title" eyebrow={t.process.eyebrow} title={t.process.title} lead={t.process.lead} />
  <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      process.map((m) => (
        <li class="reveal glass p-6 sm:p-7">
          <p class="text-sm font-semibold text-accent-text">{m.step}</p>
          <h3 class="mt-8 text-xl">{m.title[lang]}</h3>
          <p class="mt-2 text-sm text-muted">{m.body[lang]}</p>
        </li>
      ))
    }
  </ol>
</section>
