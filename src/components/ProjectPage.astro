---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
import { useT } from '../i18n/ui';
import { getLang, homeAnchor, routes } from '../i18n/utils';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const cs = p.caseStudy!;
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const [hero, ...gallery] = cs.gallery;
---

<Base
  alternates={routes.project(p.slug)}
  title={`${p.name} — ${p.tagline[lang]} · René Valderrey`}
  description={p.summary[lang]}
>
  <article class="container-page pb-8 pt-10 sm:pt-16">
    <a href={homeAnchor(lang, 'trabajos')} class="inline-flex min-h-11 items-center gap-2 text-sm text-muted hover:text-text">
      <Icon name="arrow-left" size={16} />
      {t.project.back}
    </a>

    <header class="mt-6 max-w-3xl">
      <p class="eyebrow mb-3">{p.tagline[lang]}</p>
      <h1 class="text-[clamp(2.75rem,8vw,5rem)]" style={`view-transition-name: title-${p.slug}`}>{p.name}</h1>
      <p class="mt-5 text-lg text-muted">{p.summary[lang]}</p>
      {
        p.url && (
          <a href={p.url} target="_blank" rel="noopener" class="btn btn-primary mt-8">
            {t.projects.visit}
            <Icon name="external" size={16} />
          </a>
        )
      }
    </header>

    <dl class="mt-12 grid gap-4 sm:grid-cols-3">
      {
        [
          [t.project.role, p.role[lang]],
          [t.project.period, p.period[lang]],
          [t.project.status, p.status[lang]],
        ].map(([k, v]) => (
          <div class="glass p-5">
            <dt class="text-xs font-medium uppercase tracking-wider text-subtle">{k}</dt>
            <dd class="mt-1 font-semibold">{v}</dd>
          </div>
        ))
      }
    </dl>

    {
      hero && (
        <figure
          class="mt-12 overflow-hidden rounded-[1.75rem] border border-border shadow-2xl shadow-shadow"
          style={`view-transition-name: shot-${p.slug}`}
        >
          <Image
            src={hero.src}
            alt={hero.alt[lang]}
            widths={[640, 1200, 1800]}
            sizes="(min-width: 1152px) 1104px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="block h-auto w-full"
          />
        </figure>
      )
    }

    <div class="mt-16 grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <section class="reveal">
        <h2 class="text-3xl">{t.project.problem}</h2>
        <p class="mt-4 text-muted">{cs.problem[lang]}</p>
        <h2 class="mt-10 text-3xl">{t.project.stack}</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {p.tags.map((tag) => <li class="chip">{tag}</li>)}
        </ul>
      </section>
      <div class="space-y-12">
        {
          [
            [t.project.built, cs.built[lang]],
            [t.project.decisions, cs.decisions[lang]],
          ].map(([title, items]) => (
            <section class="reveal">
              <h2 class="text-3xl">{title}</h2>
              <ul class="mt-5 space-y-3">
                {(items as string[]).map((it) => (
                  <li class="glass flex gap-4 p-5 text-muted">
                    <Icon name="check" size={20} class="mt-0.5 shrink-0 text-accent-text" />
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>

    <section class="mt-20" aria-labelledby="galeria">
      <h2 id="galeria" class="reveal text-3xl">{t.project.gallery}</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          gallery.map((g) => (
            <li class="reveal overflow-hidden rounded-2xl border border-border">
              <Image
                src={g.src}
                alt={g.alt[lang]}
                widths={[480, 900]}
                sizes="(min-width: 640px) 50vw, 100vw"
                class="block h-auto w-full"
              />
              <p class="border-t border-border bg-surface px-4 py-3 text-sm text-muted">{g.alt[lang]}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <aside class="reveal glass mt-20 flex flex-col items-start gap-5 p-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-2xl font-semibold tracking-tight">{t.project.next}</p>
      <a href={homeAnchor(lang, 'contacto')} class="btn btn-primary">
        {t.hero.ctaContact}
        <Icon name="arrow" size={18} />
      </a>
    </aside>
  </article>
</Base>
