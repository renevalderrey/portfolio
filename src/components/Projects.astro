---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { featured, projects } from '../data/projects';
import { useT } from '../i18n/ui';
import { getLang, routes } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const rest = projects.filter((p) => p !== featured);
---

<section id="trabajos" class="container-page py-16 sm:py-20" aria-labelledby="trabajos-title">
  <SectionHeader id="trabajos-title" eyebrow={t.projects.eyebrow} title={t.projects.title} lead={t.projects.lead} />

  <article class="reveal glass grid lg:grid-cols-[1fr_1.15fr]">
    <div class="flex flex-col p-7 sm:p-10">
      <p class="eyebrow mb-4">{t.projects.featured}</p>
      <h3 class="text-4xl sm:text-5xl" style={`view-transition-name: title-${featured.slug}`}>{featured.name}</h3>
      <p class="mt-2 text-lg text-muted">{featured.tagline[lang]}</p>
      <p class="mt-5 text-muted">{featured.summary[lang]}</p>
      <p class="chip mt-6 self-start font-semibold text-success">
        <Icon name="check" size={14} />
        {featured.status[lang]}
      </p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {featured.tags.map((tag) => <li class="chip">{tag}</li>)}
      </ul>
      <div class="mt-auto flex flex-wrap gap-3 pt-8">
        <a href={routes.project(featured.slug)[lang]} class="btn btn-primary">
          {t.projects.caseStudy}
          <Icon name="arrow" size={18} />
        </a>
        {
          featured.url && (
            <a href={featured.url} target="_blank" rel="noopener" class="btn btn-glass">
              {t.projects.visit}
              <Icon name="external" size={16} />
            </a>
          )
        }
      </div>
    </div>
    {
      featured.cover && (
        <div class="relative flex items-center p-4 pt-0 sm:p-8 sm:pt-0 lg:pl-0 lg:pt-8">
          <div
            class="w-full overflow-hidden rounded-2xl border border-border shadow-2xl shadow-shadow"
            style={`view-transition-name: shot-${featured.slug}`}
          >
            <Image
              src={featured.cover.src}
              alt={featured.cover.alt[lang]}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 560px, 100vw"
              class="block h-auto w-full"
            />
          </div>
        </div>
      )
    }
  </article>

  <ul class="mt-4 grid gap-4 md:grid-cols-2">
    {
      rest.map((p) => (
        <li class:list={['reveal glass flex flex-col', p.soon && 'border-dashed']}>
          {p.cover ? (
            <div class="p-2.5 pb-0">
              <div class="overflow-hidden rounded-[1.25rem] border border-border">
                <Image
                  src={p.cover.src}
                  alt={p.cover.alt[lang]}
                  widths={[480, 800, 1120]}
                  sizes="(min-width: 768px) 560px, 100vw"
                  class="block aspect-16/10 w-full object-cover object-top transition-transform duration-500 hover:scale-[1.03]"
                />
              </div>
            </div>
          ) : (
            <div class="px-6 pt-6" aria-hidden="true">
              <span class="grid size-12 place-items-center rounded-2xl border border-border bg-surface-2 text-lg font-semibold tracking-tight text-muted">
                {p.name.slice(0, 1)}
              </span>
            </div>
          )}
          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-xl">{p.name}</h3>
              <span class="text-xs font-medium text-subtle">{p.period[lang]}</span>
            </div>
            <p class="mt-1 text-sm font-medium text-accent-text">{p.tagline[lang]}</p>
            <p class="mt-3 text-sm text-muted">{p.summary[lang]}</p>
            {p.tags.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {p.tags.map((tag) => (
                  <li class="chip text-xs">{tag}</li>
                ))}
              </ul>
            )}
            <div class="mt-auto pt-5">
              {p.url ? (
                <a href={p.url} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1.5 font-semibold hover:text-accent-text">
                  {t.projects.visit}
                  <Icon name="external" size={16} />
                  <span class="visually-hidden">: {p.name}</span>
                </a>
              ) : (
                <span class="chip">{p.soon ? t.projects.soon : p.status[lang]}</span>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>
