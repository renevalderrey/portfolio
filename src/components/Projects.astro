---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { highlighted, others } from '../data/projects';
import { useT } from '../i18n/ui';
import { getLang, routes } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
---

<section id="trabajos" class="container-page py-16 sm:py-20" aria-labelledby="trabajos-title">
  <SectionHeader id="trabajos-title" eyebrow={t.projects.eyebrow} title={t.projects.title} lead={t.projects.lead} />

  <div class="space-y-4">
    {
      highlighted.map((p, i) => {
        const flip = i % 2 === 1;
        const primary = p.caseStudy ? routes.project(p.slug)[lang] : p.url;
        const primaryLabel = p.caseStudy ? t.projects.caseStudy : (p.cta?.[lang] ?? t.projects.visit);
        return (
          <article class="reveal glass grid lg:grid-cols-[1fr_1.15fr]">
            <div class:list={['flex flex-col p-7 sm:p-10', flip && 'lg:order-2']}>
              <p class="eyebrow mb-4">{i === 0 ? t.projects.featured : t.projects.collab}</p>
              <h3 class="text-4xl sm:text-5xl" style={`view-transition-name: title-${p.slug}`}>
                {p.name}
              </h3>
              <p class="mt-2 text-lg text-muted">{p.tagline[lang]}</p>
              <p class="mt-5 text-muted">{p.summary[lang]}</p>
              <p class="chip mt-6 self-start font-semibold text-success">
                <Icon name="check" size={14} />
                {p.status[lang]}
              </p>
              {p.services ? (
                <ul class="mt-5 grid gap-2 sm:grid-cols-2">
                  {p.services[lang].map((s) => (
                    <li class="flex items-center gap-2 text-sm font-medium">
                      <Icon name="check" size={16} class="shrink-0 text-accent-text" />
                      {s}
                    </li>
                  ))}
                </ul>
              ) : (
                <ul class="mt-5 flex flex-wrap gap-2">
                  {p.tags.map((tag) => (
                    <li class="chip">{tag}</li>
                  ))}
                </ul>
              )}
              <div class="mt-auto flex flex-wrap gap-3 pt-8">
                {primary && (
                  <a href={primary} class="btn btn-primary" target={p.caseStudy ? undefined : '_blank'} rel={p.caseStudy ? undefined : 'noopener'}>
                    {primaryLabel}
                    <Icon name={p.caseStudy ? 'arrow' : 'external'} size={p.caseStudy ? 18 : 16} />
                  </a>
                )}
                {p.caseStudy && p.url && (
                  <a href={p.url} target="_blank" rel="noopener" class="btn btn-glass">
                    {t.projects.visit}
                    <Icon name="external" size={16} />
                  </a>
                )}
              </div>
            </div>

            {p.cover && (
              <div
                class:list={[
                  'relative flex items-center p-4 pt-0 sm:p-8 sm:pt-0 lg:pt-8',
                  flip ? 'lg:order-1 lg:pr-0' : 'lg:pl-0',
                  p.mobile && 'pb-10 sm:pb-14 lg:pb-14',
                ]}
              >
                <div
                  class="w-full overflow-hidden rounded-2xl border border-border shadow-2xl shadow-shadow"
                  style={`view-transition-name: shot-${p.slug}`}
                >
                  <Image
                    src={p.cover.src}
                    alt={p.cover.alt[lang]}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 1024px) 560px, 100vw"
                    class="block h-auto w-full"
                  />
                </div>
                {p.mobile && (
                  <div class:list={['phone absolute bottom-3 w-[30%] max-w-40 sm:bottom-5', flip ? 'left-4 sm:left-8' : 'right-4 sm:right-8 lg:right-6']}>
                    <Image
                      src={p.mobile.src}
                      alt={p.mobile.alt[lang]}
                      widths={[240, 400]}
                      sizes="160px"
                      class="block h-auto w-full rounded-[1.1rem]"
                    />
                  </div>
                )}
              </div>
            )}
          </article>
        );
      })
    }
  </div>

  <ul class="mt-4 grid gap-4 md:grid-cols-2">
    {
      others.map((p) => (
        <li class="reveal glass flex flex-col">
          {p.cover && (
            <div class="p-2.5 pb-0">
              <div class="overflow-hidden rounded-[1.25rem] border border-border">
                <Image
                  src={p.cover.src}
                  alt={p.cover.alt[lang]}
                  widths={[480, 800, 1120]}
                  sizes="(min-width: 768px) 560px, 100vw"
                  class="block aspect-16/10 w-full object-cover object-top transition-transform duration-500 hover:scale-[1.03]"
                />
              </div>
            </div>
          )}
          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-xl">{p.name}</h3>
              <span class="text-xs font-medium text-subtle">{p.period[lang]}</span>
            </div>
            <p class="mt-1 text-sm font-medium text-accent-text">{p.tagline[lang]}</p>
            <p class="mt-3 text-sm text-muted">{p.summary[lang]}</p>
            {p.services && (
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {p.services[lang].map((s) => (
                  <li class="chip text-xs font-semibold text-text">{s}</li>
                ))}
              </ul>
            )}
            <div class="mt-auto flex flex-wrap gap-x-5 pt-5">
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1.5 font-semibold hover:text-accent-text">
                  {t.projects.visit}
                  <Icon name="external" size={16} />
                  <span class="visually-hidden">: {p.name}</span>
                </a>
              )}
              {p.links?.map((l) => (
                <a href={l.url} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1.5 font-semibold hover:text-accent-text">
                  <Icon name={l.icon ?? 'external'} size={16} />
                  {l.label[lang]}
                </a>
              ))}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Celular superpuesto a la captura: marco de vidrio grueso. */
  .phone {
    padding: 0.375rem;
    border-radius: 1.5rem;
    background: var(--color-glass-strong);
    border: 1px solid var(--color-border-strong);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow:
      inset 0 1px 0 var(--color-glass-edge),
      0 24px 48px -16px var(--color-shadow);
  }
</style>
