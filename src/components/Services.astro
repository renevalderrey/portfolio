---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { services } from '../data/home';
import { useT } from '../i18n/ui';
import { getLang, homeAnchor } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
---

<section id="servicios" class="container-page py-16 sm:py-20" aria-labelledby="servicios-title">
  <SectionHeader id="servicios-title" eyebrow={t.services.eyebrow} title={t.services.title} lead={t.services.lead} />
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      services.map((s) => (
        <li class="reveal glass group flex flex-col p-7">
          <span class="mb-6 grid size-12 place-items-center rounded-2xl bg-accent-soft text-accent-text transition-transform duration-300 group-hover:scale-110">
            <Icon name={s.icon} size={22} />
          </span>
          <h3 class="text-xl">{s.title[lang]}</h3>
          <p class="mt-2.5 text-muted">{s.body[lang]}</p>
          <ul class="mt-auto space-y-1.5 pt-6 text-sm text-muted">
            {s.items[lang].map((it) => (
              <li class="flex items-center gap-2">
                <Icon name="check" size={16} class="shrink-0 text-accent-text" />
                {it}
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
  <div class="reveal mt-10 flex justify-center">
    <a href={homeAnchor(lang, 'contacto')} class="btn btn-primary">
      {t.nav.contact}
      <Icon name="arrow" size={18} />
    </a>
  </div>
</section>
