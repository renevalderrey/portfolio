---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { services } from '../data/home';
import { useT } from '../i18n/ui';
import { getLang } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
---

<section id="servicios" class="container-page py-16" aria-labelledby="servicios-title">
  <SectionHeader id="servicios-title" eyebrow={t.services.eyebrow} title={t.services.title} lead={t.services.lead} />
  <ul class="grid gap-4 md:grid-cols-2">
    {
      services.map((s, i) => (
        <li class="reveal card group p-7">
          <div class="mb-5 flex items-center justify-between">
            <span class="grid size-12 place-items-center rounded-2xl border border-border bg-surface-2 text-accent-2 transition-colors group-hover:border-accent group-hover:text-accent">
              <Icon name={s.icon} size={22} />
            </span>
            <span class="font-mono text-xs text-subtle">0{i + 1}</span>
          </div>
          <h3 class="text-2xl font-bold">{s.title[lang]}</h3>
          <p class="mt-3 text-muted">{s.body[lang]}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {s.items[lang].map((it) => (
              <li class="chip">{it}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
