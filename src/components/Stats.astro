---
import SectionHeader from './SectionHeader.astro';
import { stats } from '../data/home';
import { useT } from '../i18n/ui';
import { getLang } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
---

<section class="container-page py-16 sm:py-20" aria-labelledby="stats-title">
  <SectionHeader id="stats-title" eyebrow={t.stats.eyebrow} title={t.stats.title} lead={t.stats.lead} />
  <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    {
      stats.map((s) => (
        <li class:list={['reveal glass flex flex-col justify-between gap-5 p-5 sm:gap-8 sm:p-7', s.span === 'wide' && 'col-span-2']}>
          <p class="text-4xl font-semibold tracking-tighter sm:text-6xl">
            {s.value}
            <span class="ml-1 inline-block size-2 rounded-full bg-accent align-top" aria-hidden="true" />
          </p>
          <div>
            <p class="font-semibold">{s.label[lang]}</p>
            <p class="mt-1 text-sm text-muted">{s.detail[lang]}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
